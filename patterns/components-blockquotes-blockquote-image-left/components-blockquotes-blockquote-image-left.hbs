<section class="blockquote-layout">
  <div class="grid-wrapper">
    <div class="grid cols-3-9">
      <div class="blockquote-media">
        <img src="../../images/taylor-eighmy.jpg" alt="Portrait of Taylor Eighmy">
      </div>
      <div>
        <blockquote>
          <p>A block quotation is set off from the main text as a paragraph or block of text. This version supports an image on the left, standard links and cite links.</p>
          <cite><a href="#">Taylor Eighmy, PhD</a></cite>
        </blockquote>
      </div>
    </div>
  </div>
</section>
