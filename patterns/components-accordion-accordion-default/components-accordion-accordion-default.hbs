<div class="accordion">
    <div class="tab">
        <input type="checkbox" name="accordion-1" id="cb1" unchecked />
        <label for="cb1" class="tab_label">Tab 1</label>
        <div class="tab_content">
            <p>This is an accordion</p>
        </div>
    </div>
    <div class="tab">
        <input type="checkbox" name="accordion-1" id="cb2" unchecked />
        <label for="cb2" class="tab_label">Tab 2</label>
        <div class="tab_content">
            <h3>This is another tab</h3>
            <p>Lorem ipsum or something</p>
        </div>
    </div>
    <div class="tab">
        <input type="checkbox" name="accordion-1" id="cb3" unchecked />
        <label for="cb3" class="tab_label">Tab 3</label>
        <div class="tab_content">
            <p>Another tab! This time with a button</p>
            <p><a class="button">Click me!</a></p>
        </div>
    </div>
    <div class="tab">
        <input type="checkbox" name="accordion-1" id="cb4" unchecked />
        <label for="cb4" class="tab_label">Tab 4</label>
        <div class="tab_content">
            <p>Last tab I promise. I included some links and stuff</p>
            <a class="arrow">I am a link</a>
        </div>
    </div>
</div>